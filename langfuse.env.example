# 로컬 Langfuse 서버용. .env.langfuse로 복사하고 서로 다른 난수를 채운다.
# 비밀번호/키를 Git에 넣지 않는다. DATABASE_URL에 들어가는 비밀번호는 URL-safe 값으로 만든다.
# ENCRYPTION_KEY는 32바이트 난수의 hex 문자열(64자)이다. 나머지는 충분히 긴 난수를 쓴다.
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
